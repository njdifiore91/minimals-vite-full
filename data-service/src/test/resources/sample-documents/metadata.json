  "document_classification_rules": {
    "application_form": {
      "required_fields": ["business_name", "owner_name", "requested_amount", "signature"],
      "common_keywords": ["application", "merchant", "cash advance", "funding", "request"]
    },
    "bank_statement": {
      "required_fields": ["account_number", "business_name", "statement_period", "ending_balance"],
      "common_keywords": ["bank", "statement", "account", "balance", "deposit", "withdrawal"]
    },
    "processing_statement": {
      "required_fields": ["merchant_id", "business_name", "statement_period", "processing_volume"],
      "common_keywords": ["merchant", "processing", "credit card", "transaction", "volume"]
    },
    "drivers_license": {
      "required_fields": ["license_number", "full_name", "date_of_birth", "expiration_date"],
      "common_keywords": ["driver", "license", "operator", "class", "restrictions"]
    },
    "business_license": {
      "required_fields": ["license_number", "business_name", "issue_date", "expiration_date"],
      "common_keywords": ["business", "license", "permit", "authorized", "jurisdiction"]
    }
  },
  "field_validation_rules": {
    "date_fields": {
      "formats": ["MM/DD/YYYY", "YYYY-MM-DD", "DD MMM YYYY"],
      "validation_rules": {
        "not_future": ["issue_date", "statement_date", "date_of_birth"],
        "future_required": ["expiration_date"],
        "age_verification": {
          "field": "date_of_birth",
          "min_age": 18,
          "max_age": 100
        }
      }
    },
    "currency_fields": {
      "formats": ["$#,###.##", "#,###.##"],
      "validation_rules": {
        "positive_required": ["requested_amount", "processing_volume", "ending_balance"],
        "range_validation": {
          "requested_amount": {
            "min": 5000,
            "max": 500000
          },
          "processing_volume": {
            "min": 1000,
            "max": 10000000
          }
        }
      }
    },
    "identification_fields": {
      "validation_rules": {
        "format_validation": {
          "ein": "##-#######",
          "ssn_last_four": "####",
          "phone": "(###) ###-####"
        },
        "length_validation": {
          "license_number": {
            "min": 6,
            "max": 20
          },
          "account_number": {
            "min": 8,
            "max": 17
          }
        }
      }
    }
  },
