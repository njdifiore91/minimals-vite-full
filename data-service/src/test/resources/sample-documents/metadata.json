  "validation_rules": {
    "business_validation": {
      "business_name": {
        "required": true,
        "min_length": 3,
        "max_length": 100
      },
      "ein": {
        "required": true,
        "pattern": "^\\d{2}-\\d{7}$",
        "error_message": "EIN must be in format XX-XXXXXXX"
      },
      "business_type": {
        "required": true,
        "allowed_values": [
          "Sole Proprietorship",
          "Partnership",
          "Limited Liability Company",
          "Corporation",
          "S Corporation",
          "C Corporation",
          "Non-Profit"
        ]
      },
      "years_in_business": {
        "required": true,
        "min_value": 1,
        "type": "integer"
      },
      "monthly_revenue": {
        "required": true,
        "min_value": 5000,
        "type": "currency"
      },
      "requested_amount": {
        "required": true,
        "min_value": 5000,
        "max_value": 500000,
        "type": "currency"
      }
    },
    "financial_validation": {
      "account_number": {
        "required": true,
        "min_length": 4,
        "max_length": 17
      },
      "statement_period": {
        "required": true,
        "pattern": "^[A-Za-z]{3} \\d{1,2}, \\d{4} - [A-Za-z]{3} \\d{1,2}, \\d{4}$|^\\d{1,2}/\\d{1,2}/\\d{4} - \\d{1,2}/\\d{1,2}/\\d{4}$",
        "error_message": "Statement period must be in format 'MMM DD, YYYY - MMM DD, YYYY' or 'MM/DD/YYYY - MM/DD/YYYY'"
      },
      "ending_balance": {
        "required": true,
        "type": "currency"
      },
      "processing_volume": {
        "required": true,
        "min_value": 1000,
        "type": "currency"
      },
      "transaction_count": {
        "required": true,
        "min_value": 1,
        "type": "integer"
      }
    },
    "identity_validation": {
      "full_name": {
        "required": true,
        "min_length": 3,
        "max_length": 100
      },
      "date_of_birth": {
        "required": true,
        "pattern": "^\\d{1,2}/\\d{1,2}/\\d{4}$",
        "min_age": 18,
        "max_age": 100,
        "error_message": "Date of birth must be in format MM/DD/YYYY and represent an age between 18 and 100"
      },
      "license_number": {
        "required": true,
        "min_length": 6,
        "max_length": 20
      },
      "expiration_date": {
        "required": true,
        "pattern": "^\\d{1,2}/\\d{1,2}/\\d{4}$|^\\d{4}-\\d{1,2}-\\d{1,2}$",
        "future_date": true,
        "error_message": "Expiration date must be in the future"
      }
    },
    "cross_document_validation": {
      "business_name_consistency": {
        "fields": ["business_name"],
        "documents": ["APPLICATION_FORM", "FINANCIAL_DOCUMENT", "BUSINESS_DOCUMENT"],
        "match_threshold": 0.9,
        "error_message": "Business name must be consistent across all documents"
      },
      "address_consistency": {
        "fields": ["business_address"],
        "documents": ["APPLICATION_FORM", "FINANCIAL_DOCUMENT", "BUSINESS_DOCUMENT"],
        "match_threshold": 0.8,
        "error_message": "Business address must be consistent across all documents"
      },
      "owner_identity_verification": {
        "application_field": "owner_name",
        "identity_field": "full_name",
        "match_threshold": 0.9,
        "error_message": "Owner name on application must match name on identity document"
      },
      "financial_data_consistency": {
        "monthly_revenue": {
          "application_field": "monthly_revenue",
          "financial_field": "processing_volume",
          "max_variance": 0.3,
          "error_message": "Monthly revenue on application should be consistent with processing volume"
        }
      }
    }
  },
