  "test_scenarios": [
    {
      "name": "High Quality Document Processing",
      "description": "Tests the system's ability to process high-quality business documents with high accuracy",
      "document_ids": ["BL-001", "TR-001", "BS-001", "INV-001"],
      "expected_accuracy": 0.99
    },
    {
      "name": "Medium Quality Document Processing",
      "description": "Tests the system's ability to process medium-quality business documents with acceptable accuracy",
      "document_ids": ["BL-002", "TR-002", "BS-002", "COI-001", "POS-002"],
      "expected_accuracy": 0.95
    },
    {
      "name": "Low Quality Document Processing",
      "description": "Tests the system's ability to process low-quality business documents and flag them for review when necessary",
      "document_ids": ["INV-002", "COI-002", "BL-003", "TR-003", "BS-003"],
      "expected_accuracy": 0.85,
      "expected_human_review_rate": 0.60
    },
    {
      "name": "Mixed Document Batch Processing",
      "description": "Tests the system's ability to process a mixed batch of business documents with varying quality",
      "document_ids": ["BL-001", "TR-002", "BS-003", "INV-002", "COI-001", "POS-002"],
      "expected_accuracy": 0.92,
      "expected_human_review_rate": 0.20
    }
  ],
  "field_validation_rules": {
    "legal_name": {
      "required": true,
      "min_confidence": 0.90,
      "validation_regex": "^[A-Z\\s\\.,&'\\-]+$"
    },
    "dba_name": {
      "required": false,
      "min_confidence": 0.85,
      "validation_regex": "^[A-Z\\s\\.,&'\\-]+$"
    },
    "ein": {
      "required": true,
      "min_confidence": 0.95,
      "validation_regex": "^\\d{2}-\\d{7}$"
    },
    "address": {
      "required": true,
      "min_confidence": 0.85,
      "nested_fields": {
        "street": {
          "required": true,
          "min_confidence": 0.85
        },
        "city": {
          "required": true,
          "min_confidence": 0.90
        },
        "state": {
          "required": true,
          "min_confidence": 0.95,
          "validation_regex": "^[A-Z]{2}$"
        },
        "zip": {
          "required": true,
          "min_confidence": 0.90,
          "validation_regex": "^\\d{5}(-\\d{4})?$"
        }
      }
    },
    "total_revenue": {
      "required": true,
      "min_confidence": 0.90,
      "validation_type": "decimal"
    },
    "total_expenses": {
      "required": true,
      "min_confidence": 0.90,
      "validation_type": "decimal"
    },
    "net_income": {
      "required": true,
      "min_confidence": 0.90,
      "validation_type": "decimal"
    },
    "incorporation_date": {
      "required": false,
      "min_confidence": 0.85,
      "validation_type": "date",
      "validation_format": "YYYY-MM-DD"
    },
    "issue_date": {
      "required": false,
      "min_confidence": 0.85,
      "validation_type": "date",
      "validation_format": "YYYY-MM-DD"
    },
    "expiration_date": {
      "required": false,
      "min_confidence": 0.85,
      "validation_type": "date",
      "validation_format": "YYYY-MM-DD"
    }
  }
}