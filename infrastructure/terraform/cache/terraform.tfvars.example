# Example Terraform variables for Redis cache infrastructure
# Copy this file to terraform.tfvars and modify as needed

# Deployment environment (development, staging, production)
environment = "development"

# AWS region for the Redis cache infrastructure
aws_region = "us-east-1"

# S3 bucket name for Terraform state
state_bucket = "mca-terraform-state"

# List of CIDR blocks allowed to access Redis (optional)
allowed_cidr_blocks = [
  "10.0.0.0/16",  # VPC CIDR
]

# KMS key ID for encryption (optional)
# kms_key_id = "arn:aws:kms:us-east-1:123456789012:key/abcd1234-ef56-gh78-ij90-klmnopqrstuv"

# SNS topic ARN for Redis alarms (optional)
# notification_topic_arn = "arn:aws:sns:us-east-1:123456789012:redis-alarms"

# Additional tags for Redis resources (optional)
tags = {
  Owner       = "MCA Team"
  CostCenter  = "12345"
  Application = "MCA Application Processing"
}