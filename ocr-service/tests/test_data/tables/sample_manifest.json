  "test_parameters": {
    "confidence_thresholds": {
      "high_quality": 0.95,
      "medium_quality": 0.85,
      "low_quality": 0.75
    },
    "accuracy_metrics": {
      "table_structure": {
        "row_count_match": "Number of rows must match exactly",
        "column_count_match": "Number of columns must match exactly",
        "header_match": "Headers must match exactly, including capitalization",
        "cell_content_match": {
          "text": "Text must match with Levenshtein distance <= 2",
          "numbers": "Numeric values must be within 0.1% of expected value",
          "currency": "Currency values must be within 0.1% of expected value",
          "dates": "Dates must match exactly in normalized format (YYYY-MM-DD)"
        }
      },
      "position_tolerance": {
        "high_quality": {"x": 10, "y": 5},
        "medium_quality": {"x": 15, "y": 10},
        "low_quality": {"x": 25, "y": 15}
      }
    },
    "performance_requirements": {
      "processing_time": {
        "per_page": "< 3 seconds",
        "per_table": "< 5 seconds"
      },
      "memory_usage": "< 1.5GB per document",
      "gpu_acceleration": "Required for production environment"
    }
  },
