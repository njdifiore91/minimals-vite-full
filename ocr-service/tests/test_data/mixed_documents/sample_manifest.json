  "test_parameters": {
    "confidence_thresholds": {
      "typed_text": {
        "high_quality": 0.95,
        "medium_quality": 0.85,
        "low_quality": 0.75
      },
      "handwritten_text": {
        "high_quality": 0.85,
        "medium_quality": 0.75,
        "low_quality": 0.65
      },
      "mixed_document": {
        "high_quality": 0.90,
        "medium_quality": 0.80,
        "low_quality": 0.70
      }
    },
    "accuracy_metrics": {
      "field_extraction": {
        "exact_match": "Value must match exactly, including capitalization and punctuation",
        "fuzzy_match": "Value must have Levenshtein distance <= 2 for short fields, <= 5 for long fields",
        "numeric_match": "Numeric values must be within 0.1% of expected value"
      },
      "position_tolerance": {
        "typed_text": {"x": 10, "y": 5},
        "handwritten_text": {"x": 20, "y": 10}
      }
    },
    "handwriting_style_factors": {
      "PRINT": {
        "expected_accuracy": 0.85,
        "confidence_adjustment": 0.0
      },
      "CURSIVE": {
        "expected_accuracy": 0.75,
        "confidence_adjustment": -0.10
      },
      "MIXED": {
        "expected_accuracy": 0.80,
        "confidence_adjustment": -0.05
      },
      "BLOCK_LETTERS": {
        "expected_accuracy": 0.90,
        "confidence_adjustment": 0.05
      }
    },
    "performance_requirements": {
      "processing_time": {
        "per_page": "< 3 seconds",
        "per_document": "< 15 seconds"
      },
      "memory_usage": "< 1.5GB per document",
      "gpu_acceleration": "Required for production environment"
    }
  },
  "challenging_scenarios": [
    {
      "scenario": "Overlapping Content",
      "description": "Handwritten annotations overlapping typed text",
      "expected_confidence_impact": "-15% to -20% for affected regions",
      "mitigation_strategy": "Layer separation and content isolation techniques"
    },
    {
      "scenario": "Mixed Text Styles",
      "description": "Documents containing both typed and handwritten text in close proximity",
      "expected_confidence_impact": "-10% to -15% at style boundaries",
      "mitigation_strategy": "Dual-model approach with style-specific processing"
    },
    {
      "scenario": "Quality Variations",
      "description": "Documents with varying quality across regions (e.g., faded handwriting on clear typed form)",
      "expected_confidence_impact": "-5% to -25% depending on severity",
      "mitigation_strategy": "Adaptive preprocessing and region-specific enhancement"
    },
    {
      "scenario": "Margin Annotations",
      "description": "Handwritten notes in margins or between form fields",
      "expected_confidence_impact": "-5% to -10% for layout analysis",
      "mitigation_strategy": "Spatial context analysis and form structure recognition"
    }
  ],
