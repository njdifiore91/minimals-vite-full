  "test_parameters": {
    "confidence_thresholds": {
      "high_quality": 0.90,
      "medium_quality": 0.80,
      "low_quality": 0.70
    },
    "accuracy_metrics": {
      "field_extraction": {
        "exact_match": "Value must match exactly, including capitalization and punctuation",
        "fuzzy_match": "Value must have Levenshtein distance <= 3 for short fields, <= 7 for long fields",
        "numeric_match": "Numeric values must be within 0.1% of expected value"
      },
      "position_tolerance": {
        "high_quality": {"x": 15, "y": 10},
        "medium_quality": {"x": 20, "y": 15},
        "low_quality": {"x": 30, "y": 20}
      }
    },
    "performance_requirements": {
      "processing_time": {
        "per_page": "< 3 seconds",
        "per_document": "< 15 seconds"
      },
      "memory_usage": "< 1.5GB per document",
      "gpu_acceleration": "Required for production environment"
    }
  },
  "handwriting_analysis": {
    "style_characteristics": {
      "cursive": {
        "description": "Connected flowing script where letters are joined together",
        "challenges": ["letter connectivity", "variable slant", "inconsistent spacing", "ambiguous character boundaries", "loop variations"],
        "expected_confidence_impact": "-10% compared to print",
        "common_errors": {
          "character_confusions": ["e/i", "a/o", "u/v", "n/m", "r/s"],
          "segmentation_issues": "Difficulty separating connected characters",
          "context_dependency": "Character recognition highly dependent on surrounding characters"
        },
        "test_focus_areas": ["signature fields", "notes", "personal information fields"]
      },
      "print": {
        "description": "Disconnected letters written individually",
        "challenges": ["character ambiguity", "inconsistent character formation", "stroke variations", "alignment issues"],
        "expected_confidence_impact": "baseline for comparison",
        "common_errors": {
          "character_confusions": ["0/O", "1/l/I", "5/S", "8/B", "2/Z"],
          "segmentation_issues": "Inconsistent spacing between characters and words",
          "context_dependency": "Less context-dependent than cursive but affected by individual writing habits"
        },
        "test_focus_areas": ["form fields", "numerical data", "addresses"]
      },
      "mixed": {
        "description": "Combination of cursive and print styles",
        "challenges": ["style transitions", "inconsistent character formation", "variable spacing", "unpredictable connectivity"],
        "expected_confidence_impact": "-15% compared to print",
        "common_errors": {
          "character_confusions": ["combines issues from both cursive and print"],
          "segmentation_issues": "Unpredictable transitions between connected and disconnected text",
          "context_dependency": "Highly variable depending on writer's habits and fatigue"
        },
        "test_focus_areas": ["longer form fields", "notes", "explanatory text"]
      },
      "block_letters": {
        "description": "All capital letters written individually",
        "challenges": ["lack of case differentiation", "spacing inconsistencies", "rigid formation"],
        "expected_confidence_impact": "+5% compared to print",
        "common_errors": {
          "character_confusions": ["E/F", "M/N", "D/O", "C/G", "P/R"],
          "segmentation_issues": "Generally fewer segmentation issues but spacing can be inconsistent",
          "context_dependency": "Less context-dependent due to standardized character shapes"
        },
