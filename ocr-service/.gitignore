# Python cache files and bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# Virtual environments
venv/
env/
.env/
.venv/
ENV/

# Environment variables and local configuration
.env
*.env
*.local
.env.*
config.local.py

# IDE specific files
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Test and coverage reports
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/
nosetests.xml
coverage.xml
*.cover

# TensorFlow model files and checkpoints
*.h5
*.pb
*.ckpt
*.ckpt.*
checkpoint
model_weights/
saved_models/

# Large data files
*.npy
*.npz
*.pkl
*.joblib

# Log files
logs/
*.log

# Temporary files
tmp/
temp/

# S3 credentials and configuration
.aws/
credentials

# RabbitMQ certificates
*.pem
*.crt
*.key

# Generated documentation
docs/_build/
site/

# Jupyter Notebooks
.ipynb_checkpoints/
*.ipynb

# Profiling data
*.prof
*.lprof

# Docker related
.dockerignore

# Ignore GPU-specific cache
.nv/
.cuda-*

# Ignore any local development scripts
local_*.py
dev_*.py

# Ignore large test data files but keep directory structure
# Tests should download these files as needed or use smaller samples
tests/test_data/**/*.jpg
tests/test_data/**/*.png
tests/test_data/**/*.pdf
tests/test_data/**/*.tiff
tests/test_data/**/*.tif
# Keep metadata files
!tests/test_data/**/metadata.json
!tests/test_data/**/*.md