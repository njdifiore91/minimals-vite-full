# Email Service Environment Configuration Example
# This file serves as a template for the required environment variables
# Copy this file to .env and update the values for your environment

# ==============================
# Application Settings
# ==============================
# Node environment: development, staging, production
NODE_ENV=development

# Service name and version
SERVICE_NAME=email-service
SERVICE_VERSION=1.0.0

# Server port for health checks and monitoring
PORT=3001

# ==============================
# IMAP Connection Settings
# ==============================
# IMAP server connection details for monitoring submissions inbox
IMAP_HOST=mail.dollarfunding.com
IMAP_PORT=993
IMAP_USER=submissions@dollarfunding.com
IMAP_PASSWORD=your-secure-password-here

# IMAP connection options
IMAP_TLS_ENABLED=true
IMAP_TLS_MIN_VERSION=TLSv1.2
IMAP_REJECT_UNAUTHORIZED=true
IMAP_CONNECTION_TIMEOUT=30000
IMAP_IDLE_TIMEOUT=300000

# Email monitoring configuration
IMAP_POLLING_INTERVAL=60000
IMAP_MAX_ATTACHMENT_SIZE=25000000
IMAP_MAILBOX=INBOX
IMAP_SEARCH_CRITERIA=["UNSEEN"]

# ==============================
# RabbitMQ Connection Settings
# ==============================
# RabbitMQ server connection details
RABBITMQ_HOST=rabbitmq.dollarfunding.com
RABBITMQ_PORT=5671
RABBITMQ_USER=email-service
RABBITMQ_PASSWORD=your-secure-password-here
RABBITMQ_VHOST=/mca

# RabbitMQ TLS configuration
RABBITMQ_TLS_ENABLED=true
RABBITMQ_TLS_CERT_PATH=/path/to/client/certificate.pem
RABBITMQ_TLS_KEY_PATH=/path/to/client/key.pem
RABBITMQ_TLS_CA_PATH=/path/to/ca/certificate.pem
RABBITMQ_REJECT_UNAUTHORIZED=true

# RabbitMQ exchange and routing configuration
RABBITMQ_EXCHANGE=mca.documents
RABBITMQ_EXCHANGE_TYPE=fanout
RABBITMQ_ROUTING_KEY=document.new
RABBITMQ_MESSAGE_PERSISTENT=true

# RabbitMQ connection retry settings
RABBITMQ_RECONNECT_ATTEMPTS=10
RABBITMQ_RECONNECT_INTERVAL=5000

# ==============================
# S3 Storage Settings
# ==============================
# S3-compatible storage connection details
S3_ENDPOINT=s3.dollarfunding.com
S3_PORT=443
S3_USE_SSL=true
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_REGION=us-east-1

# S3 bucket configuration
S3_BUCKET_NAME=mca-documents-development
# Use mca-documents-staging for staging environment
# Use mca-documents-production for production environment

# S3 encryption and security settings
S3_ENCRYPTION=AES256
S3_FORCE_PATH_STYLE=false
S3_SIGNATURE_VERSION=v4

# ==============================
# Logging Settings
# ==============================
# Log level: error, warn, info, debug
LOG_LEVEL=info

# Log format: json, pretty
LOG_FORMAT=pretty

# Log file path (for production)
LOG_FILE_PATH=/var/log/email-service/app.log

# Enable request logging
REQUEST_LOGGING=true

# ==============================
# Security Settings
# ==============================
# Virus scanning configuration
VIRUS_SCAN_ENABLED=true
VIRUS_SCAN_API_KEY=your-virus-scan-api-key
VIRUS_SCAN_ENDPOINT=https://virus-scan.dollarfunding.com/api/v1/scan

# File type validation
ALLOWED_FILE_TYPES=pdf,tiff,png,jpeg,jpg,doc,docx,xls,xlsx

# ==============================
# Monitoring Settings
# ==============================
# Enable Datadog APM
DATADOG_APM_ENABLED=false
DATADOG_API_KEY=your-datadog-api-key
DATADOG_APP_NAME=email-service
DATADOG_ENV=development

# Health check settings
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health