# Email Service Environment Configuration
# This file serves as a template for environment variables required by the Email Service microservice.
# Copy this file to .env and update the values for your environment.
# DO NOT commit the actual .env file to version control.

# ======================================================================
# APPLICATION SETTINGS
# ======================================================================

# Node environment: development, staging, production, test
NODE_ENV=development

# Application name and version
APP_NAME=email-service
APP_VERSION=1.0.0

# HTTP port for the service
PORT=3000

# Debug mode (true/false)
DEBUG=false

# ======================================================================
# LOGGING CONFIGURATION
# ======================================================================

# Log level: error, warn, info, debug
LOG_LEVEL=info

# Log directory for file logging (production only)
# LOG_DIR=/var/log/email-service

# ======================================================================
# IMAP CONNECTION SETTINGS
# ======================================================================

# IMAP server hostname
IMAP_HOST=mail.dollarfunding.com

# IMAP server port (typically 993 for IMAPS)
IMAP_PORT=993

# IMAP authentication credentials
IMAP_USER=submissions@dollarfunding.com
IMAP_PASSWORD=your-secure-password-here

# IMAP mailbox to monitor (default: INBOX)
IMAP_MAILBOX=INBOX

# Email polling interval in milliseconds (default: 60000 = 1 minute)
EMAIL_POLLING_INTERVAL=60000

# IMAP connection timeout in milliseconds
IMAP_CONNECTION_TIMEOUT=30000

# IMAP idle timeout in milliseconds
IMAP_IDLE_TIMEOUT=300000

# TLS settings (required for security)
IMAP_TLS_ENABLED=true
IMAP_TLS_REJECT_UNAUTHORIZED=true

# ======================================================================
# RABBITMQ CONNECTION SETTINGS
# ======================================================================

# RabbitMQ server hostname
RABBITMQ_HOST=rabbitmq.dollarfunding.com

# RabbitMQ server port (5671 for TLS, 5672 for non-TLS)
RABBITMQ_PORT=5671

# RabbitMQ authentication credentials
RABBITMQ_USER=email-service
RABBITMQ_PASSWORD=your-secure-password-here

# RabbitMQ virtual host
RABBITMQ_VHOST=/

# RabbitMQ exchange settings
RABBITMQ_EXCHANGE=mca.documents
RABBITMQ_EXCHANGE_TYPE=fanout

# RabbitMQ connection settings
RABBITMQ_TLS_ENABLED=true
RABBITMQ_CONNECTION_TIMEOUT=30000
RABBITMQ_HEARTBEAT=60

# ======================================================================
# S3 STORAGE CONFIGURATION
# ======================================================================

# S3-compatible storage endpoint
S3_ENDPOINT=s3.dollarfunding.com

# S3 region
S3_REGION=us-east-1

# S3 authentication credentials
S3_ACCESS_KEY=your-access-key-here
S3_SECRET_KEY=your-secret-key-here

# S3 bucket name (environment-specific)
# This will be overridden based on the environment:
# - Production: mca-documents-production
# - Staging: mca-documents-staging
# - Development: mca-documents-development (or the value below)
S3_BUCKET=mca-documents-development

# S3 connection settings
S3_USE_SSL=true
S3_FORCE_PATH_STYLE=false
S3_UPLOAD_TIMEOUT=30000

# S3 encryption settings (AES-256 required for security)
S3_ENCRYPTION_ENABLED=true

# ======================================================================
# RETRY CONFIGURATION
# ======================================================================

# Maximum number of retry attempts for operations
MAX_RETRY_ATTEMPTS=5

# Initial delay between retries in milliseconds
RETRY_INITIAL_DELAY=5000